<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="gdm_admin_action_log" resource="default" engine="innodb" comment="Admin Action Log">
        <column xsi:type="int" name="log_id" unsigned="true" nullable="false" identity="true" comment="Log ID"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="int" name="user_id" unsigned="true" nullable="true" comment="Admin User ID"/>
        <column xsi:type="varchar" name="username" nullable="true" length="64" comment="Admin Username"/>
        <column xsi:type="varchar" name="ip" nullable="true" length="45" comment="IP Address"/>
        <column xsi:type="varchar" name="action_group" nullable="true" length="64" comment="Action Group"/>
        <column xsi:type="varchar" name="action" nullable="false" length="32" comment="Action"/>
        <column xsi:type="varchar" name="result" nullable="false" length="16" default="success" comment="Result"/>
        <column xsi:type="varchar" name="request_action" nullable="true" length="255" comment="Full Action Name"/>
        <column xsi:type="varchar" name="details" nullable="true" length="255" comment="Details"/>
        <column xsi:type="mediumtext" name="changes" nullable="true" comment="Full details (JSON)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="log_id"/>
        </constraint>
        <index referenceId="GDM_ADMIN_ACTION_LOG_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
        <index referenceId="GDM_ADMIN_ACTION_LOG_USER_ID" indexType="btree">
            <column name="user_id"/>
        </index>
        <index referenceId="GDM_ADMIN_ACTION_LOG_ACTION" indexType="btree">
            <column name="action"/>
        </index>
    </table>
</schema>
